# Скопируйте этот файл в .env, если нужно что-то поменять.

# 127.0.0.1 — программа открывается только на этом компьютере.
# 0.0.0.0 — можно открыть с других устройств в сети (планшет на кассе, телевизор).
HOST=127.0.0.1
PORT=3000

# Пароль для входа. Пустой — программа открывается без пароля (только для своего компьютера).
APP_PASSWORD=

# Где хранится база. Этот файл нужно регулярно копировать в надёжное место.
DB_FILE=data/shop.db
