# Скопируйте этот файл в .env и впишите токен из CloudShop.
# Без токена дашборд показывает демо-данные.
CLOUDSHOP_TOKEN=

# Адрес API и пути к разделам. Сверьте с документацией https://connect-api.cloudshop.ru
CLOUDSHOP_API_URL=https://connect-api.cloudshop.ru/api/v4
CLOUDSHOP_PRODUCTS_PATH=/catalog
CLOUDSHOP_SALES_PATH=/sales
# Если остатки отдаются отдельным разделом, укажите его путь.
CLOUDSHOP_STOCK_PATH=

# 127.0.0.1 — открыть только на этом компьютере.
# 0.0.0.0 — открыть с других устройств в сети (например, с телевизора или планшета).
HOST=127.0.0.1
PORT=3000
